def log(message: str):
    """Log message to console and file with timestamp"""
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    line = f"[{ts}] {message}"
    print(line)
    try:
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(line + "\n")
    except Exception:
        pass


def log_file_only(message: str):
    """Log message to file only (not console). Used for verbose output."""
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    line = f"[{ts}] {message}"
    try:
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(line + "\n")
    except Exception:
        pass


def log_section(title: str):
    """Log a section header for better readability"""
    log("\n" + "=" * 80)
    log(f"  {title}")
    log("=" * 80)


def format_version_tuple(version: Optional[Tuple[int, int, int]]) -> str:
    if not version:
        return "unknown"
    return ".".join(str(part) for part in version)


def parse_version_string(version_str: str) -> Optional[Tuple[int, int, int]]:
    if not version_str:
        return None
    digits = [int(piece) for piece in re.split(r"[^0-9]", version_str) if piece.isdigit()]
    if not digits:
        return None
    while len(digits) < 3:
        digits.append(0)
    return tuple(digits[:3])  # type: ignore[return-value]


def get_uv_version() -> Optional[str]:
    """Get uv version string if available."""
    if not USE_UV:
        return None
    try:
        result = subprocess.run(
            [UV_EXE, "--version"],
            capture_output=True,
            text=True,
            timeout=5
        )
        if result.returncode == 0:
            return result.stdout.strip()
    except Exception:
        pass
    return None


def log_installer_info():
    """Log which package installer will be used."""
    if USE_UV:
        uv_version = get_uv_version()
        if uv_version:
            log(f"Package installer: {uv_version} (10-30x faster than pip)")
        else:
            log("Package installer: uv (version unknown)")
    else:
        log("Package installer: pip (uv not bundled - using standard installer)")
        log("  Note: Installation will be slower but fully functional")


def get_package_installer_cmd() -> Tuple[list, str]:
    """
    Get the appropriate package installer command prefix.

    Returns:
        tuple: (command_prefix_list, installer_name)

    uv is preferred (10-30x faster) with pip as fallback.
    """
    python_exe = os.path.join(sys.prefix, 'python.exe')

    if USE_UV:
        # uv pip install --python <path> ensures we install to the right env
        return ([UV_EXE, "pip", "install", "--python", python_exe], "uv")
    else:
        return ([python_exe, "-m", "pip", "install"], "pip")


def ensure_pynvml_loaded() -> bool:
    """Attempt to import or install pynvml for driver detection."""
    global PYNVML_AVAILABLE, pynvml

    if PYNVML_AVAILABLE:
        return True

    try:
        import importlib

        pynvml = importlib.import_module("pynvml")  # type: ignore
        PYNVML_AVAILABLE = True
        return True
    except ImportError:
        log("Installing nvidia-ml-py for NVIDIA driver detection...")
        if run_pip([
            "install",
            NVIDIA_ML_PY_REQUIREMENT,
            "--progress-bar",
            "on"
        ], "Install NVML helper"):
            try:
                import importlib

                pynvml = importlib.import_module("pynvml")  # type: ignore
                PYNVML_AVAILABLE = True
                return True
            except ImportError:
                log("WARNING: pynvml module still unavailable after installation attempt.")
    return False


def detect_nvidia_driver() -> DriverInfo:
    """Detect NVIDIA driver version using nvidia-smi or NVML."""
    smi_cmd = [
        "nvidia-smi",
        "--query-gpu=driver_version,name",
        "--format=csv,noheader",
    ]
    try:
        result = subprocess.run(
            smi_cmd,
            capture_output=True,
            text=True,
            check=True,
            encoding='utf-8',
            timeout=10
        )
        line = result.stdout.strip().splitlines()[0]
        if "," in line:
            driver_str, gpu_name = line.split(",", 1)
        else:
            driver_str, gpu_name = line, "Unknown GPU"
        driver_tuple = parse_version_string(driver_str.strip())
        if driver_tuple:
            return DriverInfo(driver_tuple, gpu_name.strip(), "nvidia-smi")
    except (FileNotFoundError, subprocess.CalledProcessError, subprocess.TimeoutExpired, IndexError):
        pass

    if ensure_pynvml_loaded():
        try:
            pynvml.nvmlInit()  # type: ignore[attr-defined]
            handle = pynvml.nvmlDeviceGetHandleByIndex(0)  # type: ignore[attr-defined]
            driver_str = pynvml.nvmlSystemGetDriverVersion()  # type: ignore[attr-defined]
            gpu_name = pynvml.nvmlDeviceGetName(handle)  # type: ignore[attr-defined]
            if isinstance(driver_str, bytes):
                driver_str = driver_str.decode('utf-8')
            if isinstance(gpu_name, bytes):
                gpu_name = gpu_name.decode('utf-8')
            driver_tuple = parse_version_string(str(driver_str))
            if driver_tuple:
                return DriverInfo(driver_tuple, str(gpu_name), "pynvml")
        except Exception as exc:  # pragma: no cover - hardware specific
            log(f"WARNING: NVML detection failed: {exc}")
        finally:
            try:
                pynvml.nvmlShutdown()  # type: ignore[attr-defined]
            except Exception:
                pass

    return DriverInfo(None, None, "none")


def detect_compute_capability() -> Optional[Tuple[int, int]]:
    """Compute capability of GPU 0 -- the card WhisperJAV uses -- from nvidia-smi.

    None when it cannot be read (no nvidia-smi, or a driver too old for the field);
    then no card warning is given and WhisperJAV's start-up check remains the safety net.
    """
    try:
        result = subprocess.run(
            ["nvidia-smi", "--query-gpu=compute_cap", "--format=csv,noheader"],
            capture_output=True, text=True, check=True, encoding="utf-8", timeout=10,
        )
        first = result.stdout.strip().splitlines()[0].strip()
        major, minor = first.split(".", 1)
        return int(major), int(minor)
    except Exception:
        return None


TEST_FORCE_COMPUTE_CAP_ENV = "WHISPERJAV_TEST_FORCE_COMPUTE_CAP"  # e.g. 6.1
TEST_FORCE_DRIVER_ENV = "WHISPERJAV_TEST_FORCE_DRIVER"            # e.g. 566.03


def apply_gpu_test_switches(driver_info: DriverInfo) -> DriverInfo:
    """Test switches: pretend to be an old card or driver, so the stops of spec E and F
    can be shown on a PC that has neither. Each use is written to the log."""
    cc_text = os.environ.get(TEST_FORCE_COMPUTE_CAP_ENV, "").strip()
    if cc_text:
        try:
            major, minor = cc_text.split(".", 1)
            driver_info = driver_info._replace(compute_capability=(int(major), int(minor)))
            log(f"TEST SWITCH {TEST_FORCE_COMPUTE_CAP_ENV}={cc_text}: compute capability set to {cc_text}")
        except ValueError:
            log(f"TEST SWITCH {TEST_FORCE_COMPUTE_CAP_ENV}={cc_text!r} ignored (expected e.g. 6.1)")
    drv_text = os.environ.get(TEST_FORCE_DRIVER_ENV, "").strip()
    if drv_text:
        version = parse_version_string(drv_text)
        if version:
            driver_info = driver_info._replace(driver_version=version)
            log(f"TEST SWITCH {TEST_FORCE_DRIVER_ENV}={drv_text}: driver set to {drv_text}")
        else:
            log(f"TEST SWITCH {TEST_FORCE_DRIVER_ENV}={drv_text!r} ignored (expected e.g. 566.03)")
    return driver_info


def read_stack_file() -> Optional[str]:
    """The stack an earlier run of this installer chose here: cu130, cu128 or cpu."""
    try:
        with open(STACK_FILE, "r", encoding="utf-8") as f:
            value = f.read().strip()
        return value if value in ("cu130", "cu128", "cpu") else None
    except OSError:
        return None


def write_stack_file(stack: str) -> None:
    try:
        with open(STACK_FILE, "w", encoding="utf-8") as f:
            f.write(stack + "\n")
        log(f"Stack recorded in {STACK_FILE}: {stack}")
    except OSError as e:
        log(f"WARNING: could not write {STACK_FILE}: {e}")


def wait_for_answer(prompt: str, valid: Sequence[str], on_no_console: str) -> str:
    """Ask until one of `valid` is typed. No time limit (owner, W37 (2)).

    With no console to read from (an unattended run), returns `on_no_console`.
    """
    while True:
        try:
            answer = input(prompt).strip()
        except (EOFError, KeyboardInterrupt):
            log(f"(no answer could be read; using '{on_no_console}')")
            return on_no_console
        if answer in valid:
            log(f"Answer: {answer}")
            return answer


def gpu_support_gate(driver_info: DriverInfo) -> Tuple[str, Optional[str]]:
    """Old card or old driver, before anything is installed (item 2 spec E and F).

    Returns ("gpu" | "cpu" | "stop", failure reason or None). Texts: the owner's (W43).
    """
    global _stopped_on_purpose
    if not driver_info.driver_version:
        return "gpu", None  # no NVIDIA GPU: the CPU path of install_pytorch decides

    cc = driver_info.compute_capability
    name = driver_info.gpu_name or "Unknown GPU"
    if cc is not None and cc < MIN_COMPUTE_CAPABILITY:
        log("\n" + "!" * 80)
        log(f"Your graphics card, {name} (compute capability {cc[0]}.{cc[1]}), is older than "
            "WhisperJAV 1.10 supports. 1.10 needs a GTX 16-series, RTX 20-series or newer card.")
        log("Choose: 1 = my card is identified wrongly (show where to report it, then stop); "
            "2 = install for the CPU only (much slower); 3 = stop.")
        log(f"WhisperJAV 1.9.5 still supports this card: {RELEASE_195_URL}.")
        log("!" * 80)
        answer = wait_for_answer("Type 1, 2 or 3 and press Enter: ", ("1", "2", "3"), "3")
        if answer == "2":
            log("Installing for the CPU only, as chosen.")
            return "cpu", None
        if answer == "1":
            log(f"Please report it here: {ISSUES_URL} (attach install_log_v{{VERSION}}.txt).")
        log("The installer will now stop.")
        _stopped_on_purpose = True
        return "stop", f"Graphics card {name} (compute capability {cc[0]}.{cc[1]}) is older than 1.10 supports; stopped (answer {answer})"

    if driver_info.driver_version < MIN_DRIVER_CUDA13:
        # As NVIDIA writes it on Windows: 566.03, not 566.3.0.
        version = f"{driver_info.driver_version[0]}.{driver_info.driver_version[1]:02d}"
        log("\n" + "!" * 80)
        log(f"Your NVIDIA driver ({version}) is older than WhisperJAV 1.10 needs (580 or newer). "
            f"Update it from {NVIDIA_DRIVER_URL}, restart the PC, and run this installer again. "
            "Nothing has been installed. Press Enter to close.")
        log("!" * 80)
        try:
            input()
        except (EOFError, KeyboardInterrupt):
            pass
        _stopped_on_purpose = True
        return "stop", f"NVIDIA driver {version} is older than 580"

    return "gpu", None


# The CUDA build of the installed PyTorch ("13.0", "12.8", or "" for CPU), as read in a
# fresh process by install_pytorch / verify_existing_torch_stack. Phase 5.1 uses it.
_torch_cuda_build: Optional[str] = None

_TORCH_FACTS_CODE = (
    "import json, torch\n"
    "facts = {'torch': torch.__version__, 'cuda': getattr(torch.version, 'cuda', None) or '',\n"
    "         'cuda_available': torch.cuda.is_available()}\n"
    "facts['device_count'] = torch.cuda.device_count() if facts['cuda_available'] else 0\n"
    "for name in ('torchaudio', 'torchvision'):\n"
    "    try:\n"
    "        facts[name] = __import__(name).__version__\n"
    "    except Exception:\n"
    "        pass\n"
    "print(json.dumps(facts))\n"
)


def torch_facts_in_fresh_process() -> Optional[dict]:
    """PyTorch's versions and CUDA build, read in a new interpreter.

    v1.10.0: this process never imports torch. Phase 5.1 may have to replace PyTorch by
    its CUDA 12.8 build, and Windows cannot replace DLLs that this process holds open.
    """
    try:
        r = subprocess.run([sys.executable, "-c", _TORCH_FACTS_CODE],
                           capture_output=True, text=True, timeout=600)
    except Exception as exc:
        log(f"Could not read PyTorch's versions: {exc}")
        return None
    if r.returncode != 0:
        return None
    try:
        return json.loads(r.stdout.strip().splitlines()[-1])
    except Exception:
        return None


def uninstall_package(name: str, description: str) -> bool:
    """Uninstall one package (run_pip only installs)."""
    python_exe = os.path.join(sys.prefix, "python.exe")
    if USE_UV:
        cmd = [UV_EXE, "pip", "uninstall", "--python", python_exe, name]
    else:
        cmd = [python_exe, "-m", "pip", "uninstall", "-y", name]
    log(f"Starting: {description}")
    try:
        returncode, _output = run_streaming(cmd, timeout=600)
    except Exception as exc:
        log(f"WARNING: {description} failed: {exc}")
        return False
    log(("SUCCESS: " if returncode == 0 else "WARNING: failed: ") + description)
    return returncode == 0


def verify_existing_torch_stack() -> Tuple[bool, Optional[str]]:
    """
    Check if CUDA-enabled torch and torchaudio meet requirements.

    Returns:
        (valid, error) — valid=True means torch is good AND constraints written.
        error is a failure reason string if something went wrong, None otherwise.
        When error is set, the caller should abort (not retry with fresh install).
    """
    global _torch_cuda_build
    log("Checking for existing CUDA-enabled PyTorch and torchaudio...")
    facts = torch_facts_in_fresh_process()
    if not facts or "torchaudio" not in facts:
        log("PyTorch stack missing.")
        return False, None

    log(f"Found PyTorch {facts['torch']}")
    log(f"Found torchaudio {facts['torchaudio']}")
    cuda_available = bool(facts.get("cuda_available"))
    log(f"PyTorch CUDA available: {'YES' if cuda_available else 'NO'}")

    if not cuda_available:
        return False, None

    cuda_str = facts.get("cuda") or ""
    cuda_tuple = parse_version_string(cuda_str)
    if not cuda_tuple:
        log("Unable to determine PyTorch CUDA version; reinstall required.")
        return False, None

    # A PC that an earlier run moved to the CUDA 12.8 build keeps it (phase 5.1).
    min_cuda = MIN_TORCH_CUDA_VERSION_FALLBACK if read_stack_file() == "cu128" else MIN_TORCH_CUDA_VERSION
    if cuda_tuple >= min_cuda:
        log(f"Existing PyTorch satisfies CUDA >= {format_version_tuple(min_cuda)}. Skipping reinstall.")
        # Create GPU constraints to protect pre-existing torch from overwrites.
        # If this fails, abort — continuing without protection risks silent
        # CUDA→CPU replacement by a later install (much harder to debug).
        gpu_pins = {k: facts[k] for k in ("torch", "torchaudio", "torchvision") if k in facts}
        _torch_cuda_build = cuda_str
        if not create_gpu_constraints(gpu_pins):
            reason = f"Cannot write GPU constraints file: {GPU_CONSTRAINTS_FILE} (check permissions/disk space)"
            log(f"FATAL: {reason}")
            log("       Without this file, subsequent installs may replace CUDA PyTorch with CPU-only.")
            return False, reason
        return True, None

    log(
        "Installed PyTorch CUDA version "
        f"{format_version_tuple(cuda_tuple)} is below required "
        f"{format_version_tuple(min_cuda)}. Reinstalling..."
    )
    return False, None


def select_torch_install_plan(driver_info: DriverInfo, force_cpu: bool = False) -> TorchInstallPlan:
    if force_cpu:
        reason = "CPU-only install chosen for a graphics card older than 1.10 supports."
    elif driver_info.driver_version:
        for entry in TORCH_DRIVER_MATRIX:
            if driver_info.driver_version >= entry.min_driver:
                args = torch_pip_args(entry.variant)
                return TorchInstallPlan(
                    pip_args=args,
                    pip_command="pip3 " + " ".join(args),
                    description=f"Install PyTorch/Torchaudio/Torchvision ({entry.cuda_version})",
                    uses_gpu=True,
                    target_label=entry.cuda_version,
                    driver_requirement=entry.min_driver,
                    driver_detected=driver_info.driver_version,
                    gpu_name=driver_info.gpu_name,
                    reason="",
                    variant=entry.variant,
                )

        min_required = TORCH_DRIVER_MATRIX[-1].min_driver
        reason = (  # not reached on a normal run: gpu_support_gate stops an older driver
            f"Detected driver {format_version_tuple(driver_info.driver_version)} "
            f"on {driver_info.gpu_name or 'GPU'} is below minimum "
            f"{format_version_tuple(min_required)} for CUDA wheels."
        )
    else:
        reason = "No NVIDIA GPU or driver detected."

    args = torch_pip_args("cpu")
    return TorchInstallPlan(
        pip_args=args,
        pip_command="pip3 " + " ".join(args),
        description="Install PyTorch/Torchaudio/Torchvision (CPU-only)",
        uses_gpu=False,
        target_label="CPU",
        driver_requirement=None,
        driver_detected=driver_info.driver_version,
        gpu_name=driver_info.gpu_name,
        reason=reason,
        variant="cpu",
    )


def torch_imports_in_fresh_process() -> Tuple[bool, str]:
    """Import torch in a new interpreter (#438). Returns (ok, last error line).
    torch only: the check after it lets a torchaudio import failure pass, and this must not be stricter."""
    try:
        r = subprocess.run([sys.executable, "-c", "import torch"],
                           capture_output=True, text=True, timeout=600)
    except Exception as exc:
        return False, str(exc)
    if r.returncode == 0:
        return True, ""
    lines = [l for l in (r.stderr or r.stdout or "").strip().splitlines() if l.strip()]
    return False, lines[-1] if lines else f"exit code {r.returncode}"


def install_pytorch_and_torchaudio(plan: TorchInstallPlan) -> bool:
    installer_label = "uv" if USE_UV else "pip"
    log(f"Installing via {installer_label}: {' '.join(plan.pip_args)}")
    # use_constraints=False: PyTorch IS the GPU package — constraints don't exist yet
    return run_pip(plan.pip_args, plan.description, use_constraints=False)


def timed_input(prompt: str, timeout_seconds: int, default_response: str = "") -> str:
    """
    Get user input with timeout, returning default if timeout expires.
    Allows unattended installation while preserving interactive option.

    Args:
        prompt: The prompt to display to user
        timeout_seconds: Seconds to wait before using default
        default_response: Value to return if timeout expires

    Returns:
        User input or default_response if timeout
    """
    import threading

    print(prompt, end='', flush=True)

    # Use threading for cross-platform timeout support
    result = [default_response]  # Mutable container for thread communication

    def get_input():
        try:
            result[0] = input()
        except (EOFError, KeyboardInterrupt):
            result[0] = default_response

    input_thread = threading.Thread(target=get_input, daemon=True)
    input_thread.start()
    input_thread.join(timeout=timeout_seconds)

    if input_thread.is_alive():
        # Timeout occurred
        print(f"\n[Auto-continuing after {timeout_seconds}s timeout - using default: '{default_response}']")
        return default_response
    else:
        return result[0]


def check_disk_space(min_gb: int = 8) -> bool:
    """Check if sufficient disk space is available"""
    try:
        total, used, free = shutil.disk_usage(sys.prefix)
        free_gb = free / (1024**3)
        log(f"Disk free space: {free_gb:.1f} GB (minimum required: {min_gb} GB)")
        if free_gb < min_gb:
            log("ERROR: Not enough free disk space for installation.")
            log(f"       Please free up at least {min_gb} GB and retry.")
            return False
        return True
    except Exception as e:
        log(f"WARNING: Could not determine disk space: {e}")
        return True  # Non-fatal, proceed with caution


def current_proxy() -> str:
    """The proxy this process will use, as the environment describes it."""
    for name in ("HTTPS_PROXY", "https_proxy", "HTTP_PROXY", "http_proxy"):
        value = os.environ.get(name, "").strip()
        if value:
            return f"{value}  (from {name})"
    return ""


def check_network(timeout: int = 10) -> bool:
    """
    Check that the sites this install downloads from can be reached.

    It says which addresses it is contacting and through which proxy, because a
    user who cannot reach them -- behind a company proxy, or in China -- cannot
    act on "network check failed" without knowing what was tried (#314, and the
    China threads).

    Reaching PyPI is still required: nothing can be installed without it.
    download.pytorch.org is reported but not required, because the CPU route
    fetches PyTorch from PyPI instead.
    """
    proxy = current_proxy()
    log("Checking the network. This install downloads from:")
    log("  PyPI:    https://pypi.org  (required)")
    log("  PyTorch: https://download.pytorch.org  (needed only for the GPU build)")
    log(f"  Proxy:   {proxy}" if proxy else "  Proxy:   none set")

    import urllib.error
    import urllib.request

    def reachable(url):
        try:
            urllib.request.urlopen(url, timeout=timeout)
            return True, ""
        except urllib.error.HTTPError:
            # The server answered. download.pytorch.org replies 403 to a bare
            # GET of its root, and that still proves the address can be reached,
            # which is the only thing being asked here. Reporting it as
            # unreachable would send every user looking for a fault they do not
            # have.
            return True, ""
        except Exception as e:
            return False, str(e)

    torch_ok, torch_error = reachable("https://download.pytorch.org")
    log(f"  download.pytorch.org: {'reachable' if torch_ok else 'NOT reachable -- ' + torch_error}")

    pypi_ok, pypi_error = reachable("https://pypi.org")
    if pypi_ok:
        log("  pypi.org: reachable")
        log("Network check: OK")
        return True

    log(f"ERROR: Network check failed: {pypi_error}")
    log("       pypi.org could not be reached, and nothing can be installed without it.")
    log(f"       Address tried: https://pypi.org")
    log(f"       Proxy in use:  {proxy if proxy else 'none set'}")
    log("       If you reach the internet through a proxy, set HTTPS_PROXY and")
    log("       HTTP_PROXY before running this installer.")
    return False


def check_ffmpeg() -> bool:
    """Check if FFmpeg is available on system PATH."""
    log("Checking for FFmpeg...")
    try:
        result = subprocess.run(
            ["ffmpeg", "-version"],
            capture_output=True,
            text=True,
            timeout=10
        )
        if result.returncode == 0:
            # Extract version from first line (e.g., "ffmpeg version 6.1.1 ...")
            first_line = result.stdout.strip().split('\n')[0] if result.stdout else ""
            log(f"  FFmpeg: {first_line}")
            return True
    except FileNotFoundError:
        pass
    except Exception as e:
        log(f"  FFmpeg check error: {e}")

    log("  ⚠ FFmpeg: NOT FOUND on system PATH")
    log("    WhisperJAV requires FFmpeg for audio/video processing.")
    log("    Install from: https://ffmpeg.org/download.html")
    log("    Or via conda: conda install -c conda-forge ffmpeg")
    return False


def check_vc_redist() -> bool:
    """Check if Visual C++ 2015-2022 Redistributable (x64) is installed."""
    log("Checking for Visual C++ Redistributable...")
    try:
        import winreg
        # VC++ 2015-2022 (v14.x) x64 - check multiple possible locations
        key_paths = [
            r"SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64",
            r"SOFTWARE\WOW6432Node\Microsoft\VisualStudio\14.0\VC\Runtimes\x64",
        ]
        for key_path in key_paths:
            try:
                key = winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, key_path)
                winreg.CloseKey(key)
                log("  VC++ Redistributable: Installed")
                return True
            except FileNotFoundError:
                continue
        log("  VC++ Redistributable: NOT FOUND")
        return False
    except Exception as e:
        log(f"  VC++ check error: {e}")
        return True  # Assume OK if can't check


def ensure_vc_redist() -> bool:
    """Ensure VC++ Redistributable is installed, download and install if missing."""
    if check_vc_redist():
        return True

    log("")
    log("Visual C++ 2015-2022 Redistributable is required for PyTorch and other native libraries.")
    log("Downloading and installing VC++ Redistributable...")

    vc_url = "https://aka.ms/vs/17/release/vc_redist.x64.exe"
    vc_path = os.path.join(os.environ.get("TEMP", sys.prefix), "vc_redist.x64.exe")

    try:
        # Download VC++ Redistributable
        log(f"  Downloading from: {vc_url}")
        import urllib.request
        urllib.request.urlretrieve(vc_url, vc_path)
        log(f"  Downloaded to: {vc_path}")

        # Install silently
        log("  Installing VC++ Redistributable (this may take a minute)...")
        result = subprocess.run(
            [vc_path, "/install", "/quiet", "/norestart"],
            capture_output=True,
            timeout=300  # 5 minute timeout
        )

        # Clean up installer
        try:
            os.remove(vc_path)
        except Exception:
            pass

        if result.returncode == 0:
            log("  VC++ Redistributable: Installed successfully")
            return True
        elif result.returncode == 1638:
            # 1638 = Another version is already installed
            log("  VC++ Redistributable: A compatible version is already installed")
            return True
        elif result.returncode == 3010:
            # 3010 = Reboot required (but install succeeded)
            log("  VC++ Redistributable: Installed (reboot may be required later)")
            return True
        else:
            log(f"  WARNING: VC++ install returned code {result.returncode}")
            log("  The installation may still work. Continuing...")
            return True  # Non-fatal, proceed

    except subprocess.TimeoutExpired:
        log("  WARNING: VC++ installation timed out")
        log("  You may need to install it manually from: https://aka.ms/vs/17/release/vc_redist.x64.exe")
        return True  # Non-fatal
    except Exception as e:
        log(f"  WARNING: Failed to install VC++ Redistributable: {e}")
        log("  You may need to install it manually from: https://aka.ms/vs/17/release/vc_redist.x64.exe")
        return True  # Non-fatal, proceed


def check_webview2_windows() -> bool:
    """Check if Microsoft Edge WebView2 runtime is installed (Windows only)"""
    import platform
    if platform.system() != 'Windows':
        return True  # Only needed on Windows

    log("Checking for Microsoft Edge WebView2 runtime...")
    try:
        import winreg
        key_paths = [
            r"SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}",
            r"SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}",
        ]
        for key_path in key_paths:
            try:
                key = winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, key_path)
                winreg.CloseKey(key)
                log("WebView2 runtime: Detected")
                return True
            except FileNotFoundError:
                continue
        log("WebView2 runtime: NOT DETECTED")
        return False
    except Exception as e:
        log(f"WARNING: Could not check WebView2 status: {e}")
        return True  # Assume OK if can't check


