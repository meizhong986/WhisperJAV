except ImportError:  # pragma: no cover - optional dependency
    pynvml = None  # type: ignore
    PYNVML_AVAILABLE = False

LOG_FILE = os.path.join(sys.prefix, "install_log_v{{VERSION}}.txt")

# ==============================================================================
# GPU Package Lock-in (prevents pip/uv from replacing GPU wheels with CPU wheels)
# ==============================================================================
# After installing PyTorch from the CUDA index, we record exact versions in a
# constraints file. All subsequent pip/uv installs use --constraint to prevent
# packages like openai-whisper, transformers, or accelerate from pulling in a
# different (CPU-only) version of torch from PyPI.
#
# See: https://pip.pypa.io/en/stable/user_guide/#constraints-files
GPU_CONSTRAINTS_FILE = os.path.join(sys.prefix, "gpu_constraints.txt")

# Whether constraints have been written (gate for --constraint injection)
_gpu_constraints_active = False


def _strip_local_version(version: str) -> str:
    """
    Strip PEP 440 local version suffix (e.g. +cpu, +cu128) from version string.

    PyTorch encodes accelerator in local version: 2.10.0+cpu, 2.10.0+cu128.
    uv's resolver cannot find these local versions on PyPI indexes, so
    constraint files must use the base version (2.10.0) instead.

    PEP 440 guarantees that ==2.10.0 matches 2.10.0+cpu and 2.10.0+cu128,
    so the constraint still prevents version changes.
    """
    return version.split('+')[0] if '+' in version else version


def create_gpu_constraints(packages: dict) -> bool:
    """
    Write a constraints file pinning GPU-specific packages.

    This prevents subsequent pip/uv installs from replacing GPU wheels
    with CPU-only versions from default PyPI.

    IMPORTANT: Local version suffixes (+cpu, +cu128) are stripped because
    uv cannot resolve them from PyPI. PEP 440 ensures ==2.10.0 still
    matches the installed 2.10.0+cu128. See install_log_v1.8.7b1.txt.

    Args:
        packages: Dict of {package_name: version_string}
                  e.g. {"torch": "2.10.0+cu128", "torchaudio": "2.10.0+cu128"}

    Returns:
        True if constraints file was written successfully
    """
    global _gpu_constraints_active

    try:
        lines = [
            "# Auto-generated by post_install - DO NOT EDIT",
            "# Pins GPU packages to prevent pip/uv from replacing with CPU versions",
            "# Note: local version suffixes (+cpu/+cu*) stripped for uv compatibility",
            "",
        ]
        for pkg, ver in packages.items():
            base_ver = _strip_local_version(ver)
            lines.append(f"{pkg}=={base_ver}")

        with open(GPU_CONSTRAINTS_FILE, "w", encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")

        _gpu_constraints_active = True
        log(f"  GPU lock-in: pinned {list(packages.keys())} in {GPU_CONSTRAINTS_FILE}")
        return True
    except Exception as e:
        log(f"  WARNING: Could not write GPU constraints file: {e}")
        return False


