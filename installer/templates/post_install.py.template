def check_cuda_driver() -> DriverInfo:
    """Log and return detected NVIDIA driver information."""
    log("Checking for NVIDIA GPU and driver version...")
    driver_info = detect_nvidia_driver()

    if driver_info.driver_version:
        driver_info = driver_info._replace(compute_capability=detect_compute_capability())
        driver_info = apply_gpu_test_switches(driver_info)
        cc = driver_info.compute_capability
        log(
            f"Detected NVIDIA driver {format_version_tuple(driver_info.driver_version)} "
            f"for GPU {driver_info.gpu_name or 'Unknown GPU'} "
            f"via {driver_info.source}; compute capability "
            f"{f'{cc[0]}.{cc[1]}' if cc else 'not readable'}."
        )
    else:
        log("No NVIDIA GPU detected or driver information unavailable.")

    return driver_info


def plan_pytorch(driver_info: Optional[DriverInfo] = None,
                 force_cpu: bool = False) -> Tuple[Optional[TorchInstallPlan], Optional[str]]:
    """Choose the PyTorch build for this PC, before anything is installed.

    Returns (None, None) when a valid PyTorch is already there and is kept, (plan, None)
    when the plan's build is to be installed, or (None, reason) to stop. v1.10.0 (item
    2f): split from install_pytorch so the locked file of the chosen build can be
    installed first -- PyTorch is installed --no-deps and imports only once its
    dependencies are in place.
    """
    existing_ok, existing_error = verify_existing_torch_stack()
    if existing_ok:
        return None, None
    if existing_error:
        # Torch exists and is valid, but constraints couldn't be written.
        # Don't waste time reinstalling — the filesystem problem won't fix itself.
        return None, existing_error

    driver_info = driver_info or detect_nvidia_driver()
    try:
        plan = select_torch_install_plan(driver_info, force_cpu=force_cpu) if force_cpu else select_torch_install_plan(driver_info)
    except (OSError, RuntimeError) as exc:
        return None, f"The installer's locked requirements file is missing or damaged: {exc}"

    if plan.uses_gpu:
        log(
            f"Preparing to install CUDA-enabled PyTorch ({plan.target_label}) "
            f"for GPU {plan.gpu_name or 'Unknown GPU'} with driver "
            f"{format_version_tuple(plan.driver_detected)}"
        )
    elif force_cpu:
        log("Installing CPU-only PyTorch, as chosen.")
    else:
        log("\n" + "!" * 80)
        log("  GPU ACCELERATION NOT AVAILABLE")
        log("!" * 80)
        if plan.reason:
            log(plan.reason)
        log("\nWithout CUDA this installer will configure CPU-only PyTorch.")
        log("Processing will be significantly slower (6-10x).")
        response = timed_input("Install CPU-only PyTorch? (Y/n): ", 20, "y").strip().lower()
        if response != 'y':
            log("User declined CPU-only PyTorch installation.")
            return None, "User declined CPU-only PyTorch"
    return plan, None


def install_pytorch(driver_info: Optional[DriverInfo] = None, force_cpu: bool = False,
                    plan: Optional[TorchInstallPlan] = None) -> Optional[str]:
    """
    Install PyTorch/Torchaudio with best available acceleration.

    Without a plan it chooses one first (plan_pytorch). Returns None on success, or a
    failure reason string for diagnostics.
    """
    log_section("PyTorch Installation")

    if plan is None:
        plan, error = plan_pytorch(driver_info, force_cpu=force_cpu)
        if error:
            return error
        if plan is None:
            return None  # the existing PyTorch is kept

    if not install_pytorch_and_torchaudio(plan):
        return "PyTorch package installation failed (pip/uv error)"

    # #438: uv can "install" PyTorch in seconds from a damaged download cache and
    # report success, and PyTorch then fails to import. Check in a fresh process
    # (a failed import here would stay cached in this one); if it fails, download
    # it once more past the cache. The reporter's fix was clearing %LOCALAPPDATA%\uv\cache.
    imports_ok, import_error = torch_imports_in_fresh_process()
    if not imports_ok and USE_UV:
        log(f"PyTorch was installed but does not import: {import_error}")
        log("The uv download cache may be damaged. Downloading PyTorch again without the cache...")
        if not run_pip(plan.pip_args + ["--reinstall", "--no-cache"],
                       plan.description + " (fresh download)", use_constraints=False):
            return "PyTorch did not import and the fresh download failed (uv error)"
        imports_ok, import_error = torch_imports_in_fresh_process()
    if not imports_ok:
        log(f"FATAL: PyTorch was installed but does not import: {import_error}")
        if USE_UV:
            log(r"       Delete the folder %LOCALAPPDATA%\uv\cache and run the installer again.")
        return f"PyTorch installed but does not import: {import_error}"

    global _torch_cuda_build
    try:
        facts = torch_facts_in_fresh_process()
        if not facts:
            raise RuntimeError("could not read PyTorch's versions in a fresh process")

        log(f"PyTorch {facts['torch']} installed successfully!")
        if facts.get("cuda_available"):
            log(f"CUDA acceleration: ENABLED (devices: {facts.get('device_count')})")
        else:
            log("CUDA acceleration: DISABLED (CPU-only mode)")
        _torch_cuda_build = facts.get("cuda") or ""

        # Lock GPU packages: pin torch/torchaudio to prevent subsequent pip installs
        # from replacing CUDA wheels with CPU-only versions from PyPI.
        # If this fails, abort — continuing without protection risks silent
        # CUDA→CPU replacement by a later install (much harder to debug).
        gpu_pins = {k: facts[k] for k in ("torch", "torchaudio", "torchvision") if k in facts}
        if not create_gpu_constraints(gpu_pins):
            log("FATAL: Cannot write GPU constraints file.")
            log(f"       Check write permissions to: {GPU_CONSTRAINTS_FILE}")
            log("       Without this file, subsequent installs may replace CUDA PyTorch with CPU-only.")
            return f"Cannot write GPU constraints file: {GPU_CONSTRAINTS_FILE} (check permissions/disk space)"

    except Exception as exc:
        log(f"FATAL: PyTorch installed but verification/pinning failed: {exc}")
        log("       Cannot guarantee GPU package protection. Aborting.")
        return f"PyTorch verification/pinning failed: {exc}"

    return None


# Track if Git timeouts have been configured (only do it once)
_git_timeouts_configured = False


def is_git_network_error(error_output: str) -> bool:
    """
    Detect if error was caused by Git network failure (timeout, DNS, proxy).

    Common scenarios:
    - 21-second TCP timeout: Windows default when GFW blocks GitHub
    - DNS resolution failure: bundled git doesn't inherit system proxy
    - Connection refused/reset: firewall or proxy issues

    See: https://github.com/meizhong986/WhisperJAV/issues/111
    See: https://github.com/meizhong986/WhisperJAV/issues/210
    """
    network_patterns = [
        "Failed to connect to github.com port 443 after 21",
        "Connection timed out after",
        "Could not connect to server",
        "Connection reset by peer",
        "Connection refused",
        "Could not resolve host",
        "Couldn't resolve host",
        "name or service not known",
        "No address associated with hostname",
        "SSL certificate problem",
    ]
    error_lower = error_output.lower()
    return any(pattern.lower() in error_lower for pattern in network_patterns)


def configure_git_for_slow_connections() -> bool:
    """
    Configure Git with extended timeouts and proxy for users behind GFW.

    This addresses two distinct failure modes:
    1. 21-second TCP timeout: Windows default when GFW blocks/slows GitHub
    2. DNS resolution failure: bundled git doesn't inherit system proxy

    See: https://github.com/meizhong986/WhisperJAV/issues/111
    See: https://github.com/meizhong986/WhisperJAV/issues/210

    Returns:
        True if configuration succeeded, False otherwise
    """
    global _git_timeouts_configured

    if _git_timeouts_configured:
        return True

    log("")
    log("=" * 60)
    log("  Configuring Git for slow/unstable connections (GFW mode)")
    log("=" * 60)
    log("Detected connection timeout. This often happens with VPN or")
    log("behind the Great Firewall. Configuring extended timeouts...")
    log("")

    # Find Git executable
    git_exe = shutil.which("git")
    if not git_exe:
        # Try common locations
        for path in [
            os.path.join(sys.prefix, "Library", "bin", "git.exe"),
            r"C:\Program Files\Git\bin\git.exe",
            r"C:\Program Files (x86)\Git\bin\git.exe",
        ]:
            if os.path.exists(path):
                git_exe = path
                break

    if not git_exe:
        log("WARNING: Git executable not found. Cannot configure timeouts.")
        return False

    log(f"Using Git: {git_exe}")

    # Git timeout configurations
    # See: https://git-scm.com/docs/git-config
    git_configs = [
        # Connection timeout: 120 seconds (was 21 seconds default)
        ("http.connectTimeout", "120"),
        # Overall operation timeout: 300 seconds (5 minutes)
        ("http.timeout", "300"),
        # Disable speed-based abortion for slow connections
        ("http.lowSpeedLimit", "0"),
        ("http.lowSpeedTime", "999999"),
        # Larger buffer for slow connections (512MB)
        ("http.postBuffer", "524288000"),
        # More retries on failure
        ("http.maxRetries", "5"),
    ]

    success = apply_git_settings_for_this_install(git_configs)

    # Also set environment variables for the current process
    os.environ["GIT_HTTP_CONNECT_TIMEOUT"] = "120"
    os.environ["GIT_HTTP_TIMEOUT"] = "300"
    log("")
    log("Environment variables set:")
    log("  GIT_HTTP_CONNECT_TIMEOUT=120")
    log("  GIT_HTTP_TIMEOUT=300")
    log("")

    # Also detect and propagate system proxy (fixes DNS resolution failures)
    log("Checking for system proxy settings...")
    detect_and_configure_proxy()
    log("")

    if success:
        log("+ Git configured for slow connections. Retrying installation...")
        _git_timeouts_configured = True
    else:
        log("! Some Git configurations failed, but will attempt to continue.")
        _git_timeouts_configured = True  # Don't retry configuration

    log("")
    return success


_proxy_configured = False


def detect_and_configure_proxy() -> bool:
    """
    Detect system proxy settings and propagate to environment and bundled git.

    Chinese users (GFW) typically access GitHub via VPN/proxy configured at the
    OS level. The conda-bundled git doesn't inherit these settings, causing DNS
    resolution failures even when the system browser/git works fine.

    See: https://github.com/meizhong986/WhisperJAV/issues/210
    """
    global _proxy_configured

    if _proxy_configured:
        return True

    # 1. Check if proxy already in environment
    for var in ['HTTPS_PROXY', 'HTTP_PROXY', 'https_proxy', 'http_proxy']:
        proxy = os.environ.get(var, "").strip()
        if proxy:
            log(f"  Proxy already set: {var}={proxy}")
            # Ensure both upper and lower case are set for compatibility
            os.environ['HTTP_PROXY'] = proxy
            os.environ['HTTPS_PROXY'] = proxy
            os.environ['http_proxy'] = proxy
            os.environ['https_proxy'] = proxy
            _configure_git_proxy(proxy)
            _proxy_configured = True
            return True

    # 2. Check Windows registry for system proxy (IE/Edge settings)
    try:
        import winreg
        key = winreg.OpenKey(
            winreg.HKEY_CURRENT_USER,
            r'Software\Microsoft\Windows\CurrentVersion\Internet Settings'
        )
        proxy_enable, _ = winreg.QueryValueEx(key, 'ProxyEnable')
        if proxy_enable:
            proxy_server, _ = winreg.QueryValueEx(key, 'ProxyServer')
            if proxy_server:
                if not proxy_server.startswith('http'):
                    proxy_server = f'http://{proxy_server}'
                os.environ['HTTP_PROXY'] = proxy_server
                os.environ['HTTPS_PROXY'] = proxy_server
                os.environ['http_proxy'] = proxy_server
                os.environ['https_proxy'] = proxy_server
                log(f"  Windows system proxy detected: {proxy_server}")
                _configure_git_proxy(proxy_server)
                _proxy_configured = True
                return True
        winreg.CloseKey(key)
    except Exception:
        pass

    log("  No system proxy detected.")
    _proxy_configured = True  # Don't retry detection
    return False


def git_supports_environment_config() -> bool:
    """
    True when the git we will use honours GIT_CONFIG_COUNT (git 2.31, 2021).

    Worth asking, because on an older git the settings below would be silently
    ignored -- and they are the ones that make a slow or proxied connection work
    at all, so failing to apply them quietly would be worse than the problem.
    """
    git_exe = shutil.which("git")
    if not git_exe:
        bundled = os.path.join(sys.prefix, "Library", "bin", "git.exe")
        if os.path.exists(bundled):
            git_exe = bundled
    if not git_exe:
        return False

    try:
        result = subprocess.run([git_exe, "--version"], capture_output=True,
                                text=True, timeout=10)
        parts = result.stdout.strip().split()
        version = parts[2] if len(parts) > 2 else ""
        major, minor = (int(n) for n in version.split(".")[:2])
        return (major, minor) >= (2, 31)
    except Exception:
        return False


def apply_git_settings_for_this_install(settings: list) -> bool:
    """
    Apply git settings to this install only, through the environment.

    git reads GIT_CONFIG_COUNT / GIT_CONFIG_KEY_n / GIT_CONFIG_VALUE_n and they
    reach every git it starts from here, including the one pip runs for a
    git+https install.

    Until v1.9.3 these were written with "git config --global", which changed
    git for everything else the user does on that machine, permanently, with
    nothing offering to undo it -- including an http.proxy pointing at a proxy
    that may only exist today. An installer has no business doing that.
    """
    if not git_supports_environment_config():
        log("  NOTE: the git on this machine is older than 2.31 and cannot take")
        log("        these settings from the environment. Skipping them rather")
        log("        than writing into your global git configuration.")
        return False

    start = int(os.environ.get("GIT_CONFIG_COUNT", "0") or 0)
    for offset, (key, value) in enumerate(settings):
        os.environ[f"GIT_CONFIG_KEY_{start + offset}"] = key
        os.environ[f"GIT_CONFIG_VALUE_{start + offset}"] = value
        log(f"  + {key} = {value}  (this install only)")
    os.environ["GIT_CONFIG_COUNT"] = str(start + len(settings))
    return True


def _configure_git_proxy(proxy_url: str) -> None:
    """Configure bundled git to use the detected proxy."""
    git_exe = shutil.which("git")
    if not git_exe:
        bundled = os.path.join(sys.prefix, "Library", "bin", "git.exe")
        if os.path.exists(bundled):
            git_exe = bundled

    if not git_exe:
        return

    if apply_git_settings_for_this_install([("http.proxy", proxy_url),
                                            ("https.proxy", proxy_url)]):
        log(f"  Using proxy for git: {proxy_url}  (this install only)")
    else:
        log(f"  WARNING: could not apply the proxy to git: {proxy_url}")


def filter_pip_specific_args(args: list, installer_name: str) -> list:
    """
    Filter out pip-specific arguments that uv doesn't support.

    uv and pip have different CLI interfaces. This function removes
    pip-specific arguments when using uv.

    Incompatible arguments:
    - --progress-bar: uv shows progress by default, no flag needed
    - --timeout: uv uses UV_HTTP_TIMEOUT env var instead

    Args:
        args: List of arguments
        installer_name: "uv" or "pip"

    Returns:
        Filtered list of arguments
    """
    if installer_name == "pip":
        return args  # pip supports all these arguments

    # Filter out pip-specific arguments for uv
    filtered = []
    skip_next = False
    for i, arg in enumerate(args):
        if skip_next:
            skip_next = False
            continue

        # --progress-bar on/off OR --progress-bar=on/off - uv doesn't support this
        # Handle both space-separated (--progress-bar on) and joined (--progress-bar=on)
        if arg.startswith("--progress-bar"):
            if "=" not in arg:
                skip_next = True  # Skip the next argument (on/off) for space-separated
            continue  # Skip this argument in both cases

        # --timeout=X or --timeout X - uv uses UV_HTTP_TIMEOUT env var
        if arg.startswith("--timeout"):
            if "=" not in arg:
                skip_next = True  # Skip the next argument (timeout value)
            continue

        filtered.append(arg)

    return filtered


# How long the console may stay silent while an install is running. The PyTorch
# wheels are gigabytes, and pip prints nothing at all while a single wheel
# downloads. With the output captured until the command finished, #314 saw an
# unmoving screen for many minutes and reasonably concluded the installer had
# frozen. Something has to arrive regularly, even when pip says nothing.
INSTALL_HEARTBEAT_SECONDS = 15

# Lines worth putting on screen as they happen. Everything else goes to the log
# file, because pip's per-file chatter would bury these.
_INSTALL_PROGRESS_PREFIXES = (
    "collecting", "downloading", "installing", "building", "preparing",
    "prepared", "resolved", "successfully", "uninstalling", "using cached",
    "error", "warning", "fatal",
)


def _is_install_progress(line: str) -> bool:
    return line.strip().lower().startswith(_INSTALL_PROGRESS_PREFIXES)


def run_streaming(cmd: list, timeout: int) -> tuple:
    """
    Run an install command and show what it is doing while it does it.

    Returns (returncode, combined_output). Every line is written to the log
    file; the console gets the lines that say what is happening, and a heartbeat
    with the elapsed time whenever nothing has been said for a while -- which is
    most of a large wheel download.

    stderr is merged into stdout so the order on screen is the order it happened.

    Raises subprocess.TimeoutExpired if the command outlives `timeout`, whether
    it is producing output or sitting silent.
    """
    import queue
    import threading

    process = subprocess.Popen(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        encoding="utf-8",
        errors="replace",
        bufsize=1,
    )

    lines_queue = queue.Queue()

    def _read(stream):
        try:
            for line in stream:
                lines_queue.put(line)
        except Exception:
            pass
        finally:
            lines_queue.put(None)

    reader = threading.Thread(target=_read, args=(process.stdout,), daemon=True)
    reader.start()

    started = time.time()
    last_spoke = started
    collected = []

    try:
        while True:
            elapsed = time.time() - started
            remaining = timeout - elapsed
            if remaining <= 0:
                process.kill()
                process.wait()
                raise subprocess.TimeoutExpired(
                    cmd, timeout, output="\n".join(collected))

            try:
                line = lines_queue.get(timeout=min(1.0, remaining))
            except queue.Empty:
                # Silence. This is the download itself, and the reason #314
                # thought the installer had died.
                if time.time() - last_spoke >= INSTALL_HEARTBEAT_SECONDS:
                    log(f"  ... still working ({int(elapsed)}s elapsed)")
                    last_spoke = time.time()
                continue

            if line is None:
                break

            line = line.rstrip()
            if not line:
                continue

            collected.append(line)
            log_file_only(f"  {line}")
            if _is_install_progress(line):
                log(f"  {line}")
                last_spoke = time.time()

        process.wait(timeout=max(1.0, timeout - (time.time() - started)))
    finally:
        try:
            if process.stdout:
                process.stdout.close()
        except Exception:
            pass

    return process.returncode, "\n".join(collected)


def run_pip(args: list, description: str, retries: int = 3,
            allow_fail: bool = False, use_constraints: bool = True) -> bool:
    """
    Run package install command with retries and smart Git timeout handling.

    Uses uv (if available) for 10-30x faster installation, with pip fallback.
    If a Git timeout is detected (common with GFW/VPN), this function will
    automatically configure Git with extended timeouts and retry.

    Note: pip-specific arguments (--progress-bar, --timeout) are automatically
    filtered out when using uv. uv uses UV_HTTP_TIMEOUT env var for timeouts.

    GPU Protection: When gpu_constraints.txt exists and use_constraints=True,
    all install commands automatically include --constraint to prevent pip/uv
    from replacing CUDA packages with CPU-only versions from PyPI.

    Args:
        args: Pip-style arguments (e.g., ["install", "package"])
        description: Human-readable description for logging
        retries: Number of retry attempts (default 3)
        allow_fail: If True, return False on failure instead of logging FATAL
        use_constraints: If True, inject --constraint gpu_constraints.txt
                         Set to False for PyTorch install itself (Phase 3)

    Returns:
        True if successful, False otherwise
    """
    global _git_timeouts_configured

    log(f"Starting: {description}")

    # Get installer command prefix (uv or pip)
    installer_prefix, installer_name = get_package_installer_cmd()

    # Normalize args: if first arg is "install", skip it (already in prefix)
    normalized_args = args[1:] if args and args[0] == "install" else args

    # Filter out pip-specific arguments when using uv
    normalized_args = filter_pip_specific_args(normalized_args, installer_name)

    # Inject GPU constraints to prevent CUDA→CPU package replacement
    # Only for "install" commands when constraints file exists and is active
    is_install = args and args[0] == "install"
    if (use_constraints and _gpu_constraints_active and is_install
            and os.path.exists(GPU_CONSTRAINTS_FILE)
            and "--no-deps" not in args):
        normalized_args = ["-c", GPU_CONSTRAINTS_FILE] + normalized_args

    # Build the command
    cmd = installer_prefix + normalized_args

    # Check if this is a git+https install (more timeout-sensitive)
    is_git_install = any("git+" in str(arg) for arg in args)

    # For pip only: add timeout flag for git installs (uv uses UV_HTTP_TIMEOUT env var)
    if installer_name == "pip" and is_git_install and "--timeout" not in str(args):
        cmd = installer_prefix + ["--timeout=120"] + normalized_args

    for attempt in range(retries):
        # Log command (truncate if too long)
        cmd_str = ' '.join(cmd)
        display_cmd = cmd_str[:120] + '...' if len(cmd_str) > 120 else cmd_str
        log(f"[{installer_name}] Attempt {attempt+1}/{retries}: {display_cmd}")

        try:
            # Streamed rather than captured: see run_streaming. 30 minute limit
            # for large downloads, as before.
            returncode, output = run_streaming(cmd, timeout=1800)
            if returncode != 0:
                raise subprocess.CalledProcessError(returncode, cmd, output=output)
            log(f"SUCCESS: {description}")
            return True

        except subprocess.TimeoutExpired:
            log(f"ERROR: {description} timed out (30 minutes)")
            if attempt < retries - 1:
                log("Retrying in 10 seconds...")
                time.sleep(10)

        except subprocess.CalledProcessError as e:
            log(f"ERROR: {description} failed (rc={e.returncode})")
            error_output = ""
            if e.stdout:
                lines = e.stdout.strip().split('\n')
                for line in lines[-20:]:
                    log(f"  {line}")
                error_output += e.stdout
            if e.stderr:
                lines = e.stderr.strip().split('\n')
                for line in lines[-20:]:
                    log(f"  {line}")
                error_output += e.stderr

            # Check for Git network errors (Issue #111 timeout, #210 DNS)
            if is_git_install and is_git_network_error(error_output):
                if not _git_timeouts_configured:
                    log("")
                    log("Detected Git network failure (common with VPN/GFW/proxy).")
                    configure_git_for_slow_connections()
                    # Don't count this as a failed attempt
                    log("Retrying with extended timeouts and proxy...")
                    time.sleep(5)
                    continue

            if attempt < retries - 1:
                log("Retrying in 10 seconds...")
                time.sleep(10)

        except Exception as e:
            log(f"ERROR: Unexpected error during package installation: {e}")
            if attempt < retries - 1:
                log("Retrying in 10 seconds...")
                time.sleep(10)

    if allow_fail:
        log(f"WARNING: {description} failed after {retries} attempts (non-fatal)")
    else:
        log(f"FATAL: {description} failed after {retries} attempts")
    return False


def get_config_directory() -> str:
    """
    Get the WhisperJAV configuration directory.

    Config location: %APPDATA%\\WhisperJAV (e.g., C:\\Users\\Name\\AppData\\Roaming\\WhisperJAV)
    This is the standard location for user configuration on Windows.

    Returns:
        Path to the config directory
    """
    appdata = os.environ.get("APPDATA")
    if not appdata:
        # Fallback for edge cases
        appdata = os.path.join(os.path.expanduser("~"), "AppData", "Roaming")
    return os.path.join(appdata, "WhisperJAV")


def setup_config_directory() -> bool:
    """
    Create the WhisperJAV configuration directory if it doesn't exist.

    Returns:
        True if successful, False otherwise
    """
    config_dir = get_config_directory()
    log(f"Setting up config directory: {config_dir}")

    try:
        if not os.path.exists(config_dir):
            os.makedirs(config_dir, exist_ok=True)
            log(f"  Created config directory: {config_dir}")
        else:
            log(f"  Config directory already exists")
        return True
    except Exception as e:
        log(f"  WARNING: Could not create config directory: {e}")
        return False


def migrate_config() -> bool:
    """
    Migrate configuration from old locations to new %APPDATA% location.

    Migration sources (in priority order):
    1. %LOCALAPPDATA%\\WhisperJAV\\whisperjav_config.json (old installer location)
    2. Installation directory\\whisperjav_config.json (legacy location)

    This function is idempotent - if config already exists in new location,
    it will not overwrite it.

    Returns:
        True if migration was successful or not needed, False on error
    """
    config_dir = get_config_directory()
    new_config_path = os.path.join(config_dir, "whisperjav_config.json")

    # If config already exists in new location, skip migration
    if os.path.exists(new_config_path):
        log(f"  Config already exists in new location, skipping migration")
        return True

    # Potential old config locations
    old_locations = []

    # 1. Old %LOCALAPPDATA% location (from previous installer versions)
    localappdata = os.environ.get("LOCALAPPDATA")
    if localappdata:
        old_locations.append(os.path.join(localappdata, "WhisperJAV", "whisperjav_config.json"))

    # 2. Installation directory (legacy location)
    old_locations.append(os.path.join(sys.prefix, "whisperjav_config.json"))

    # Try to find and migrate config from old locations
    for old_path in old_locations:
        if os.path.exists(old_path):
            try:
                log(f"  Found config at old location: {old_path}")
                log(f"  Migrating to: {new_config_path}")

                # Ensure config directory exists
                os.makedirs(config_dir, exist_ok=True)

                # Copy config to new location
                shutil.copy2(old_path, new_config_path)
                log(f"  ✓ Config migrated successfully")

                # Note: We don't delete the old config - user may have other installations
                return True

            except Exception as e:
                log(f"  WARNING: Could not migrate config: {e}")
                # Non-fatal - user can reconfigure
                return True

    log(f"  No existing config found - fresh installation")
    return True


def create_failure_file(error_message: str):
    """Create a failure marker file with troubleshooting info"""
    failure_file = os.path.join(sys.prefix, "INSTALLATION_FAILED_v{{VERSION}}.txt")
    try:
        with open(failure_file, "w", encoding="utf-8") as f:
            f.write("WhisperJAV v{{VERSION}} Installation Failed\n")
            f.write("=" * 80 + "\n\n")
            f.write(f"Error: {error_message}\n\n")
            f.write("Manual Cleanup Steps:\n")
            f.write(f"1. Delete installation directory: {sys.prefix}\n")
            f.write("2. Delete desktop shortcut: WhisperJAV v{{VERSION}}.lnk\n")
            f.write(f"3. Check install_log_v{{VERSION}}.txt for details\n\n")
            f.write("Common Solutions:\n")
            f.write("- Out of disk space: Free up 8GB and retry\n")
            f.write("- Permission error: Run installer as administrator, or check antivirus\n")
            f.write("- Network error: Check internet connection and firewall.\n")
            f.write("    The install log names the addresses that were tried and\n")
            f.write("    the proxy in use. If you reach the internet through a\n")
            f.write("    proxy, set HTTPS_PROXY and HTTP_PROXY before running\n")
            f.write("    this installer.\n")
            f.write("- CUDA error: Update NVIDIA drivers or try CPU mode\n")
            f.write("- WebView2 missing: Install from https://go.microsoft.com/fwlink/p/?LinkId=2124703\n\n")
            f.write(f"Full details: {LOG_FILE}\n\n")
            f.write("Support: https://github.com/meizhong986/WhisperJAV/issues\n")
        log(f"Failure details written to: {failure_file}")
    except Exception:
        pass


def get_installation_size_gb() -> Optional[float]:
    """Calculate total installation size in GB."""
    try:
        total_size = 0
        for dirpath, dirnames, filenames in os.walk(sys.prefix):
            for f in filenames:
                fp = os.path.join(dirpath, f)
                try:
                    total_size += os.path.getsize(fp)
                except OSError:
                    pass
        return total_size / (1024 ** 3)
    except Exception:
        return None


def get_gpu_vram_mb() -> Optional[Tuple[str, int]]:
    """Get GPU name and VRAM in MB via nvidia-smi."""
    try:
        result = subprocess.run(
            ["nvidia-smi", "--query-gpu=name,memory.total",
             "--format=csv,noheader,nounits"],
            capture_output=True,
            text=True,
            timeout=10
        )
        if result.returncode == 0:
            line = result.stdout.strip().splitlines()[0]
            if "," in line:
                name, vram_str = line.split(",", 1)
                return name.strip(), int(vram_str.strip())
    except Exception:
        pass
    return None


def verify_import(module_name: str, display_name: str) -> Tuple[bool, Optional[str], bool]:
    """
    Try to import a module and return (success, version_or_error, timed_out).

    Uses subprocess to avoid polluting the installer's own process with
    heavy imports (torch, whisper, etc. consume memory and may conflict).

    timed_out is reported separately because a check that ran out of time has
    not shown that anything is wrong -- the first import of torch off a freshly
    written site-packages, with antivirus reading every file, is slow. Since a
    failed check now ends the install, a slow machine must not be told its
    install is broken. See commit 63936e1: the earlier 30 s limit caused false
    failures on real installs.
    """
    python_exe = os.path.join(sys.prefix, 'python.exe')
    try:
        result = subprocess.run(
            [python_exe, "-c",
             f"import {module_name}; v = getattr({module_name}, '__version__', 'OK'); print(v)"],
            capture_output=True,
            text=True,
            timeout=120  # First import of torch/whisper can take 60s+ on fresh install
        )
        if result.returncode == 0:
            version = result.stdout.strip() or "OK"
            return True, version, False
        else:
            error = result.stderr.strip().split('\n')[-1] if result.stderr else "unknown error"
            return False, error, False
    except subprocess.TimeoutExpired:
        return False, "check did not finish within 120s", True
    except Exception as e:
        return False, str(e), False


def fetch_firered_vad_model() -> bool:
    """
    Download FireRedVAD's weights now, so the first Fidelity run needs no network.

    Runs in the INSTALLED interpreter, not this one, so it uses the environment the
    user will actually run. It calls WhisperJAV's own resolver, which is the single
    place that knows the repository, and applies the HuggingFace resilience patch
    first so this inherits the hf-mirror.com fallback that users in China rely on.

    Returns True on success. A failure is logged and ignored: see the phase comment.
    """
    python_exe = os.path.join(sys.prefix, 'python.exe')
    code = (
        "from whisperjav.utils.model_loader import patch_hf_hub_downloads; "
        "patch_hf_hub_downloads(); "
        "from whisperjav.modules.speech_segmentation.backends.firered_vad "
        "import ensure_model_downloaded; "
        "print(ensure_model_downloaded())"
    )
    log("Downloading the FireRedVAD speech-detection model (about 2.3 MB)...")
    log("  Source: https://huggingface.co/FireRedTeam/FireRedVAD (VAD subfolder)")
    try:
        result = subprocess.run(
            [python_exe, "-c", code],
            capture_output=True,
            text=True,
            timeout=300,
        )
    except subprocess.TimeoutExpired:
        log("  WARNING: the download did not finish within 300s - skipping")
        log("  WhisperJAV will fetch it at the start of the first Fidelity run.")
        return False
    except Exception as e:
        log(f"  WARNING: could not run the download step: {e}")
        return False

    if result.returncode == 0:
        location = (result.stdout or "").strip().splitlines()
        log(f"  OK Model ready: {location[-1] if location else 'downloaded'}")
        return True

    detail = (result.stderr or "").strip().splitlines()
    log(f"  WARNING: the model was not downloaded: {detail[-1] if detail else 'unknown error'}")
    log("  This does NOT break the installation. Balanced, Fast and Faster do not")
    log("  use this model. WhisperJAV will try again at the start of the first")
    log("  Fidelity run and tell you what to do if it still cannot be fetched.")
    log("  If this machine cannot reach Hugging Face, download it once elsewhere:")
    log("    huggingface-cli download FireRedTeam/FireRedVAD --local-dir <folder>")
    log("    (in China: modelscope download --model xukaituo/FireRedVAD --local_dir <folder>)")
    log("  then set WHISPERJAV_FIREREDVAD_MODEL_DIR to that folder.")
    return False


def run_post_install_verification() -> Tuple[int, int, list, list]:
    """
    Phase 6: Post-install verification.

    Checks that the installed application actually works by testing:
    1. Core whisperjav import
    2. Entry point executables exist
    3. Key dependency imports
    4. FFmpeg availability
    5. GPU VRAM info

    Returns:
        (pass_count, fail_count, warnings_list, failures_list)

    failures_list names the checks that failed, so the caller can say which
    ones in the failure marker file. A failure here means WhisperJAV will not
    run; warnings mean an optional feature is unavailable.
    """
    passes = 0
    fails = 0
    warnings = []
    failures = []

    # --- 6.1: WhisperJAV import smoke test ---
    log("")
    log("  6.1 WhisperJAV Import Smoke Test")
    log("  " + "-" * 40)

    ok, detail, timed_out = verify_import("whisperjav", "WhisperJAV")
    if ok:
        log(f"  ✓ import whisperjav: {detail}")
        passes += 1
    elif timed_out:
        log(f"  ⚠ import whisperjav: {detail} — not treated as a failure")
        warnings.append("import whisperjav did not finish in time; could not be checked")
    else:
        log(f"  ✗ import whisperjav FAILED: {detail}")
        fails += 1
        failures.append("import whisperjav")

    # Test the main entry point import
    python_exe = os.path.join(sys.prefix, 'python.exe')
    try:
        # Importing whisperjav.main runs its start-up GPU check, which on a machine
        # without a usable GPU stops and asks (v1.9.2). This is an import check, not
        # a run, so answer for it; otherwise a CPU-only install would report a failure.
        import_env = dict(os.environ, WHISPERJAV_CPU_ACCEPTED="1")
        result = subprocess.run(
            [python_exe, "-c", "from whisperjav.main import main; print('OK')"],
            capture_output=True, text=True, timeout=120,  # First import loads torch, whisper — slow on cold cache
            env=import_env,
        )
        if result.returncode == 0:
            log("  ✓ from whisperjav.main import main: OK")
            passes += 1
        else:
            error = result.stderr.strip().split('\n')[-1] if result.stderr else "unknown"
            log(f"  ✗ from whisperjav.main import main FAILED: {error}")
            fails += 1
            failures.append("from whisperjav.main import main")
    except subprocess.TimeoutExpired:
        log("  ⚠ from whisperjav.main import main: did not finish within 120s "
            "— not treated as a failure")
        warnings.append("whisperjav.main import did not finish in time; could not be checked")
    except Exception as e:
        log(f"  ✗ from whisperjav.main import main FAILED: {e}")
        fails += 1
        failures.append("from whisperjav.main import main")

    # --- 6.2: Entry point executables ---
    log("")
    log("  6.2 Entry Point Executables")
    log("  " + "-" * 40)

    entry_points = [
        ("whisperjav.exe", True),
        ("whisperjav-gui.exe", True),
        ("whisperjav-translate.exe", False),
        ("whisperjav-upgrade.exe", False),
    ]
    for exe_name, is_critical in entry_points:
        exe_path = os.path.join(sys.prefix, "Scripts", exe_name)
        if os.path.exists(exe_path):
            size_kb = os.path.getsize(exe_path) // 1024
            log(f"  ✓ {exe_name} ({size_kb} KB)")
            passes += 1
        else:
            if is_critical:
                log(f"  ✗ {exe_name}: NOT FOUND (critical)")
                fails += 1
                failures.append(f"{exe_name} was not created")
            else:
                log(f"  ⚠ {exe_name}: not found (optional)")
                warnings.append(f"{exe_name} not found")

    # Check --version on whisperjav.exe
    wj_exe = os.path.join(sys.prefix, "Scripts", "whisperjav.exe")
    if os.path.exists(wj_exe):
        try:
            result = subprocess.run(
                [wj_exe, "--version"],
                capture_output=True, text=True, timeout=120  # First invocation imports torch
            )
            if result.returncode == 0:
                version_str = result.stdout.strip()
                log(f"  ✓ whisperjav --version: {version_str}")
                passes += 1
            else:
                log(f"  ⚠ whisperjav --version: exit code {result.returncode}")
                warnings.append("whisperjav --version returned non-zero")
        except Exception as e:
            log(f"  ⚠ whisperjav --version: {e}")
            warnings.append(f"whisperjav --version: {e}")

    # --- 6.3: Key dependency imports ---
    log("")
    log("  6.3 Key Package Verification")
    log("  " + "-" * 40)

    key_packages = [
        ("torch", "PyTorch"),
        ("whisper", "OpenAI Whisper"),
        ("stable_whisper", "Stable-TS"),
        ("faster_whisper", "Faster-Whisper"),
        ("webview", "PyWebView"),
        ("srt", "SRT"),
        ("yaml", "PyYAML"),
    ]

    for module, display in key_packages:
        ok, detail, timed_out = verify_import(module, display)
        if ok:
            log(f"  ✓ {display}: {detail}")
            passes += 1
        elif timed_out:
            log(f"  ⚠ {display}: {detail} — not treated as a failure")
            warnings.append(f"{display} did not finish importing in time; could not be checked")
        else:
            log(f"  ✗ {display}: FAILED ({detail})")
            fails += 1
            failures.append(f"{display} could not be imported")

    # Optional packages (non-critical)
    optional_packages = [
        ("transformers", "Transformers"),
    ]
    for module, display in optional_packages:
        ok, detail, _timed_out = verify_import(module, display)
        if ok:
            log(f"  ✓ {display}: {detail}")
            passes += 1
        else:
            log(f"  ⚠ {display}: not available ({detail})")
            warnings.append(f"{display} not importable")

    # --- 6.4: FFmpeg ---
    log("")
    log("  6.4 FFmpeg")
    log("  " + "-" * 40)
    if check_ffmpeg():
        passes += 1
    else:
        warnings.append("FFmpeg not on PATH")

    # --- 6.5: GPU VRAM ---
    log("")
    log("  6.5 GPU Information")
    log("  " + "-" * 40)
    vram_info = get_gpu_vram_mb()
    if vram_info:
        gpu_name, vram_mb = vram_info
        log(f"  ✓ GPU: {gpu_name}")
        log(f"  ✓ VRAM: {vram_mb} MB ({vram_mb / 1024:.1f} GB)")
        if vram_mb < 4096:
            log("    ⚠ Low VRAM — large models may not fit. Consider using 'faster' mode.")
            warnings.append(f"Low VRAM ({vram_mb} MB)")
        passes += 1
    else:
        log("  - No NVIDIA GPU detected (or nvidia-smi unavailable)")

    # --- 6.6: Installation size ---
    log("")
    log("  6.6 Installation Size")
    log("  " + "-" * 40)
    install_size = get_installation_size_gb()
    if install_size is not None:
        log(f"  Installation size: {install_size:.1f} GB")
    else:
        log("  Could not determine installation size")

    return passes, fails, warnings, failures


def print_installation_summary(install_start_time: float,
                               verification_results: Optional[Tuple[int, int, list, list]] = None):
    """Print a comprehensive installation summary"""
    install_duration = int(time.time() - install_start_time)
    minutes = install_duration // 60
    seconds = install_duration % 60

    log("\n\n")
    log("=" * 80)
    log(" " * 20 + "WhisperJAV v{{VERSION}} Installation Complete!")
    log("=" * 80)
    log("")
    log("Installation Summary:")
    log(f"  ✓ Installation directory: {sys.prefix}")
    log(f"  ✓ Python version: {sys.version.split()[0]}")

    # Show which package installer was used
    if USE_UV:
        uv_version = get_uv_version()
        if uv_version:
            log(f"  ✓ Package installer: {uv_version} (fast mode)")
        else:
            log(f"  ✓ Package installer: uv (fast mode)")
    else:
        log(f"  ✓ Package installer: pip (standard mode)")

    try:
        import torch
        if torch.cuda.is_available():
            log(f"  ✓ PyTorch: {torch.__version__} with CUDA {torch.version.cuda}")
            gpu_label = torch.cuda.get_device_name(0)
            vram_info = get_gpu_vram_mb()
            if vram_info:
                _, vram_mb = vram_info
                log(f"  ✓ GPU: {gpu_label} ({vram_mb / 1024:.1f} GB VRAM)")
            else:
                log(f"  ✓ GPU: {gpu_label}")
        else:
            log(f"  ✓ PyTorch: {torch.__version__} (CPU-only mode)")
            log(f"  ⚠ GPU acceleration: DISABLED (processing will be slower)")
    except Exception:
        log(f"  ? PyTorch: Status unknown")

    if check_webview2_windows():
        log(f"  ✓ WebView2 runtime: Detected")
    else:
        log(f"  ⚠ WebView2 runtime: NOT DETECTED (GUI will not work)")
        log(f"    Install from: https://go.microsoft.com/fwlink/p/?LinkId=2124703")

    # Installation size
    install_size = get_installation_size_gb()
    if install_size is not None:
        log(f"  ✓ Installation size: {install_size:.1f} GB")

    # Verification results
    if verification_results:
        passes, fails, warnings, failures = verification_results
        if fails == 0:
            log(f"  ✓ Verification: {passes} checks passed")
        else:
            log(f"  ⚠ Verification: {passes} passed, {fails} FAILED")
        if warnings:
            for w in warnings:
                log(f"    ⚠ {w}")

    log(f"  ✓ Installation time: {minutes}m {seconds}s")
    log("")
    log("Next Steps:")
    log("  1. Launch WhisperJAV from the desktop shortcut")
    log("  2. On first run, AI models will download (~3GB, 5-10 minutes)")
    log("  3. Select your video files and start processing!")
    log("")
    log(f"Logs saved to: {LOG_FILE}")
    log("=" * 80)
    log("")


# ==============================================================================
# Phase 5.1: cuBLAS 12 for faster-whisper, and the per-PC CUDA 12.8 fallback
# ==============================================================================
# Item 2 spec C and D; owner W37 (3), W42 (4), W43. The placing and the load check are
# whisperjav.installer.cublas12, run in fresh processes after the wheel is installed:
# one implementation for this installer, whisperjav-upgrade and `whisperjav --check`.

def run_cublas12_step(step: str) -> Tuple[bool, str]:
    """`python -m whisperjav.installer.cublas12 place|check` in a fresh process."""
    try:
        r = subprocess.run([sys.executable, "-m", "whisperjav.installer.cublas12", step],
                           capture_output=True, text=True, timeout=300)
    except Exception as exc:
        return False, str(exc)
    out = (r.stdout or "").strip()
    if not out:
        err_lines = [l for l in (r.stderr or "").strip().splitlines() if l.strip()]
        out = err_lines[-1] if err_lines else f"exit code {r.returncode}"
    return r.returncode == 0, out


def show_cublas12_fallback_notice() -> None:
    """The owner's notice (M3, W43), loud and clear, the moment the check fails."""
    log("\n" + "!" * 80)
    log("!" * 80)
    log("WARNING: This PC could not load the CUDA 12 library (cublas64_12.dll) that Balanced, "
        "Fast, Faster and Kotoba need next to CUDA 13. WhisperJAV will now install its CUDA 12.8 "
        "build instead of the standard CUDA 13 build. Please report this so it can be fixed: "
        f"{ISSUES_URL} — attach install_log_v{{VERSION}}.txt. Press Enter to continue.")
    log("!" * 80)
    log("!" * 80)
    try:
        input()
    except (EOFError, KeyboardInterrupt):
        pass


def ctranslate2_package_dir() -> str:
    """CTranslate2's package folder in this environment (where cuBLAS 12 is placed)."""
    return os.path.join(sys.prefix, "Lib", "site-packages", "ctranslate2")


def install_cuda128_fallback() -> Optional[str]:
    """Replace the CUDA 13.0 PyTorch by the CUDA 12.8 build; undo the cuBLAS 12 placing.

    With the CUDA 12.8 build, CTranslate2 finds cuBLAS 12 in PyTorch's own folder, as in
    1.9.5. The placed copies are removed (CTranslate2 would load them first) and
    ctranslate2 is reinstalled so its folder is as shipped.
    """
    log_section("Phase 5.1b: Installing the CUDA 12.8 build")
    try:
        args = torch_pip_args("cu128") + ["--reinstall" if USE_UV else "--force-reinstall"]
    except (OSError, RuntimeError) as exc:
        return f"CUDA 12.8 fallback: the locked requirements file is missing or damaged: {exc}"
    if not run_pip(args, "Install PyTorch/Torchaudio/Torchvision (CUDA 12.8)", use_constraints=False):
        return "CUDA 12.8 fallback: PyTorch installation failed (pip/uv error)"
    ok, err = torch_imports_in_fresh_process()
    if not ok:
        return f"CUDA 12.8 fallback: PyTorch installed but does not import: {err}"
    facts = torch_facts_in_fresh_process()
    if not facts or not facts.get("cuda", "").startswith("12.8"):
        return f"CUDA 12.8 fallback: the installed PyTorch is not the CUDA 12.8 build ({facts})"
    if not create_gpu_constraints({k: facts[k] for k in ("torch", "torchaudio", "torchvision") if k in facts}):
        return f"Cannot write GPU constraints file: {GPU_CONSTRAINTS_FILE}"

    ct2_dir = ctranslate2_package_dir()
    for name in ("cublas64_12.dll", "cublasLt64_12.dll"):
        path = os.path.join(ct2_dir, name)
        if os.path.exists(path):
            try:
                os.remove(path)
                log(f"Removed {path}")
            except OSError as e:
                return f"CUDA 12.8 fallback: could not remove {path}: {e}"
    uninstall_package(CUBLAS12_PACKAGE.split("==")[0], "Remove nvidia-cublas-cu12 (not needed with CUDA 12.8)")
    try:  # the locked version, not a copy of it here (review 2026-10-14, item 2f)
        ct2 = [l for l in locked_requirement_lines("cu128") if requirement_name(l) == "ctranslate2"][0]
    except (OSError, IndexError) as exc:
        return f"CUDA 12.8 fallback: no ctranslate2 line in the locked requirements file ({exc})"
    if not run_pip(["install", "--no-deps", "--reinstall" if USE_UV else "--force-reinstall",
                    ct2], "Reinstall CTranslate2 as shipped", use_constraints=False):
        return "CUDA 12.8 fallback: CTranslate2 reinstall failed"
    return None


def cublas12_phase() -> Optional[str]:
    """Place cuBLAS 12, check it loads; fall back to CUDA 12.8 where it does not.

    Returns None on success (either stack), or a failure reason.
    """
    log_section("Phase 5.1: CUDA 12 library for faster-whisper")
    # A download or file problem is an ordinary install failure (running the installer
    # again is the right advice), not "this PC cannot load cuBLAS 12" -- only the load
    # check below decides that (spec D; review 2026-10-14).
    if not run_pip(["install", CUBLAS12_PACKAGE, "--progress-bar", "on"],
                   "Install cuBLAS 12 (for faster-whisper next to CUDA 13)"):
        return "installing nvidia-cublas-cu12 (cuBLAS 12 for faster-whisper) failed"
    ok, detail = run_cublas12_step("place")
    log(f"Place cuBLAS 12 in CTranslate2's folder: {detail}")
    if not ok:
        return f"placing cuBLAS 12 in CTranslate2's folder failed: {detail}"
    passed, reason = run_cublas12_step("check")
    log(f"cuBLAS 12 load check (fresh process): {reason}")
    if passed:
        write_stack_file("cu130")
        return None

    log(f"cuBLAS 12 check FAILED: {reason}")
    show_cublas12_fallback_notice()
    error = install_cuda128_fallback()
    if error:
        return error
    write_stack_file("cu128")
    return None


def embed_icon_in_exe(exe_path: str, icon_path: str) -> bool:
    """
    Embed icon into executable file using LIEF library.

    Args:
        exe_path: Path to the .exe file
        icon_path: Path to the .ico file

    Returns:
        True if successful, False otherwise
    """
    try:
        log("Embedding icon into executable...")

        # Try to import lief, install if not available
        try:
            import lief
        except ImportError:
            log("Installing LIEF library for icon embedding...")
            result = subprocess.run(
                [sys.executable, "-m", "pip", "install", LIEF_REQUIREMENT],
                capture_output=True,
                text=True,
                timeout=60
            )
            if result.returncode != 0:
                log("INFO: Could not install LIEF library")
                return False
            import lief

        # Load the executable
        binary = lief.parse(exe_path)
        if not binary:
            log("INFO: Could not parse executable with LIEF")
            return False

        # Use the resources manager from the parsed binary (LIEF 0.15+ API)
        resources_manager = binary.resources_manager
        if resources_manager is None:
            log("INFO: Executable has no resources section — cannot embed icon")
            return False

        resources_manager.change_icon(icon_path)

        # Rebuild and write
        builder = lief.PE.Builder(binary)
        builder.build_resources(True)
        builder.build()
        builder.write(exe_path)

        log("✓ Icon embedded successfully")
        return True

    except Exception as e:
        log(f"INFO: Could not embed icon: {e}")
        log("      The executable will use default Python icon")
        log("      The desktop shortcut will still display the correct icon")
        return False


def copy_launcher_to_root() -> str:
    """
    Copy Scripts/whisperjav-gui.exe to installation root as WhisperJAV-GUI.exe
    and embed the whisperjav icon into it.

    Returns:
        Path to copied .exe or None if failed
    """
    scripts_exe = os.path.join(sys.prefix, "Scripts", "whisperjav-gui.exe")
    root_exe = os.path.join(sys.prefix, "WhisperJAV-GUI.exe")
    icon_file = os.path.join(sys.prefix, "whisperjav_icon.ico")

    if not os.path.exists(scripts_exe):
        log(f"INFO: Scripts launcher not found: {scripts_exe}")
        log(f"      This is normal - the shortcut will use pythonw.exe instead")
        log(f"      (Both methods work equally well)")
        return None

    try:
        log(f"Copying launcher to root directory...")
        shutil.copy2(scripts_exe, root_exe)

        if os.path.exists(root_exe):
            log(f"✓ Launcher created: WhisperJAV-GUI.exe")
            log(f"  Users can double-click this file to launch the GUI")

            # Try to embed icon if icon file exists
            if os.path.exists(icon_file):
                embed_icon_in_exe(root_exe, icon_file)
            else:
                log(f"INFO: Icon file not found: {icon_file}")
                log(f"      Desktop shortcut will still show correct icon")

            return root_exe
        else:
            log(f"INFO: Could not create launcher in root (will use pythonw.exe fallback)")
            return None

    except Exception as e:
        log(f"INFO: Could not copy launcher: {e}")
        log(f"      The shortcut will use pythonw.exe fallback instead")
        return None


def main() -> int:
    """Main installation workflow"""
    install_start_time = time.time()

    # The installer stops the install when this marker exists, so it has to mean
    # "THIS run failed". A marker left behind by an earlier attempt in the same
    # folder would otherwise fail a install that actually worked.
    stale_marker = os.path.join(sys.prefix, "INSTALLATION_FAILED_v{{VERSION}}.txt")
    if os.path.exists(stale_marker):
        try:
            os.remove(stale_marker)
        except Exception:
            # Leave it: better to fail an install that worked than to pass one
            # that did not. The log records why.
            pass
    # The same for the stop marker (D1): it must mean "THIS run stopped".
    if os.path.exists(STOPPED_MARKER):
        try:
            os.remove(STOPPED_MARKER)
        except Exception:
            pass

    log_section("WhisperJAV v{{VERSION}} Post-Install Started")
    log(f"Installation prefix: {sys.prefix}")
    log(f"Python executable: {sys.executable}")
    log(f"Python version: {sys.version}")
    log_installer_info()  # Log which package installer (uv or pip) will be used

    # === Phase 1: Preflight Checks ===
    log_section("Phase 1: Preflight Checks")

    # Check write permission to installation directory
    log("Checking write permission to installation directory...")
    try:
        test_file = os.path.join(sys.prefix, ".write_test")
        with open(test_file, "w") as f:
            f.write("ok")
        os.remove(test_file)
        log("  Write permission: OK")
    except PermissionError:
        log("  FATAL: No write permission to installation directory!")
        log(f"  Directory: {sys.prefix}")
        create_failure_file("No write permission to installation directory")
        return 1
    except Exception as e:
        log(f"  Write permission check warning: {e}")
        # Non-fatal, proceed

    if not check_disk_space(8):
        create_failure_file("Insufficient disk space (8GB required)")
        return 1

    if not check_network():
        create_failure_file("Network connectivity required")
        return 1

    # Ensure VC++ Redistributable is installed (required for PyTorch, native libs)
    ensure_vc_redist()

    # Setup config directory in %APPDATA% and migrate from old location if needed
    log("")
    log("Setting up configuration directory...")
    setup_config_directory()
    migrate_config()

    # Check FFmpeg (non-fatal warning — user can install later)
    check_ffmpeg()

    # Check WebView2 (non-fatal, but prompt user)
    if not check_webview2_windows():
        prompt_webview2_install()

    # === Phase 2: GPU and CUDA Detection ===
    log_section("Phase 2: GPU and CUDA Detection")
    driver_info = check_cuda_driver()

    # === Phase 2.5: Card and driver supported by 1.10? (item 2 spec E, F) ===
    gate, gate_reason = gpu_support_gate(driver_info)
    if gate == "stop":
        create_stopped_file(gate_reason)
        return 0  # not a failure (D1): NSIS shows the closing dialog for the marker

    # === Phase 3: PyTorch build for this PC (item 2f) ===
    # Chosen before anything is installed: the locked file of that build is installed
    # next, then PyTorch itself (--no-deps; it needs the packages of phase 4 to import).
    log_section("Phase 3: PyTorch Build Selection")
    torch_plan, plan_error = plan_pytorch(driver_info, force_cpu=(gate == "cpu"))
    if plan_error:
        create_failure_file(f"PyTorch installation failed: {plan_error}")
        return 1
    # The build actually selected: the plan's, or the one already installed and kept
    # (a repair run). Never a build that was only detected (owner, W56).
    variant = torch_plan.variant if torch_plan else variant_of_cuda_build(_torch_cuda_build or "")
    if variant is None:
        create_failure_file(f"Installed PyTorch has an unexpected CUDA build: {_torch_cuda_build}")
        return 1

    # === Phase 4: Release-pinned dependencies (item 2f) ===
    # Every line of the locked file except PyTorch's three packages and what conda
    # already put here (owner W52), --no-deps: the file is complete, so nothing is
    # resolved on this PC. Git packages are in it at the commits uv.lock records.
    log_section("Phase 4: Release-Pinned Dependencies")
    try:
        locked_lines = locked_requirement_lines(variant)
    except OSError as exc:
        log(f"ERROR: cannot read {locked_requirements_path(variant)}: {exc}")
        create_failure_file(f"Missing requirements file: {locked_requirements_path(variant)}")
        return 1
    conda_packages, conda_unidentified = conda_python_packages()
    if not check_conda_packages(locked_lines, conda_packages, conda_unidentified):
        create_failure_file("conda installed a package at a version other than the pinned one")
        return 1
    install_lines = release_pinned_install_lines(locked_lines, conda_packages)
    install_file = os.path.join(sys.prefix, f"requirements_v{{VERSION}}_{variant}_install.txt")
    with open(install_file, "w", encoding="utf-8") as f:
        f.write("\n".join(install_lines) + "\n")

    # Proactively detect and propagate system proxy for bundled git.
    # Chinese users often have proxies at OS level that bundled git can't see.
    detect_and_configure_proxy()

    log(f"Installing release-pinned dependencies ({VARIANT_LABELS[variant]})...")
    log(f"  {len(install_lines)} packages from {locked_requirements_path(variant)}")
    if not run_pip(
        ["install", "--no-deps", "-r", install_file, "--progress-bar", "on"],
        "Install Python dependencies"
    ):
        create_failure_file("Dependencies installation failed")
        return 1

    # === Phase 4.5: PyTorch ===
    log_section("Phase 4.5: PyTorch Installation")
    pytorch_error = install_pytorch(driver_info, force_cpu=(gate == "cpu"), plan=torch_plan) if torch_plan else None
    if pytorch_error:
        create_failure_file(f"PyTorch installation failed: {pytorch_error}")
        return 1

    # === Phase 5: WhisperJAV Application ===
    log_section("Phase 5: WhisperJAV Application Installation")

    # Find WhisperJAV wheel in installation directory
    import glob
    wheel_pattern = os.path.join(sys.prefix, "whisperjav-*.whl")
    wheels = glob.glob(wheel_pattern)

    if not wheels:
        log(f"ERROR: No WhisperJAV wheel found matching: {wheel_pattern}")
        log("ERROR: The installer package may be corrupted or incomplete")
        create_failure_file(f"Missing local wheel (pattern: {wheel_pattern})")
        return 1

    if len(wheels) > 1:
        log(f"WARNING: Multiple wheels found, using first: {wheels[0]}")

    local_wheel = wheels[0]
    log(f"Installing WhisperJAV from local wheel: {local_wheel}")
    log("Using --no-deps to avoid reinstalling dependencies...")

    if not run_pip(
        ["install", "--no-deps", local_wheel, "--progress-bar", "on"],
        "Install WhisperJAV application"
    ):
        create_failure_file("WhisperJAV application installation failed")
        return 1

    # === Phase 5.1: cuBLAS 12 for faster-whisper; per-PC CUDA 12.8 fallback ===
    # Decided by the PyTorch build installed now (_torch_cuda_build, read in a fresh
    # process), not by an older whisperjav_stack.txt: a repair run that had to reinstall
    # PyTorch gets CUDA 13.0 again and must go through the check (review 2026-10-14).
    build = _torch_cuda_build or ""
    if build.startswith("13"):
        stack_error = cublas12_phase()
        if stack_error:
            create_failure_file(stack_error)
            return 1
    elif build.startswith("12.8"):
        write_stack_file("cu128")  # kept from an earlier run's fallback
    elif build:
        log(f"WARNING: unexpected PyTorch CUDA build {build}; cuBLAS 12 not placed")
    else:
        write_stack_file("cpu")

    # === Phase 5.5: Copy Launcher to Root ===
    log_section("Phase 5.5: User-Friendly Launcher Setup")
    launcher_exe = copy_launcher_to_root()

    # === Phase 5.6: Speech Detection Model ===
    #
    # WHY THIS IS AT INSTALL TIME (owner, 2026-09-12).
    # The Fidelity pipeline finds speech with FireRedVAD. The pip package holds the
    # code only -- upstream's README is explicit that the weights are a separate
    # download. Fetching them on first run means a user behind a firewall needs their
    # proxy up when they transcribe; fetching them here means they need it once, now,
    # while they are already installing over the network. It is ~2.3 MB.
    #
    # NOT FATAL. A user who only runs Balanced never needs this model, and WhisperJAV
    # checks for it again at the start of any run that does need it, stopping there
    # with instructions. Failing the whole install over an optional 2.3 MB file would
    # be the opposite of the "a failure that breaks the user's core use stops the
    # install" rule -- this breaks nothing at install time.
    log_section("Phase 5.6: Speech Detection Model (FireRedVAD)")
    fetch_firered_vad_model()

    # === Phase 5.8: Verify Icon File ===
    log_section("Phase 5.8: Icon File Verification")
    icon_path = os.path.join(sys.prefix, 'whisperjav_icon.ico')
    if os.path.exists(icon_path):
        icon_size = os.path.getsize(icon_path)
        log(f"✓ Icon file found: {icon_path}")
        log(f"  Size: {icon_size:,} bytes")
        if icon_size < 1000:
            log(f"  WARNING: Icon file may be corrupted (too small)")
    else:
        log(f"✗ WARNING: Icon file NOT found at: {icon_path}")
        log(f"  This may cause the application icon to not display correctly.")
        log(f"  Checking alternative locations...")

        # Check if it's in the package
        site_packages_icon = os.path.join(sys.prefix, 'Lib', 'site-packages', 'whisperjav', 'webview_gui', 'assets', 'whisperjav_icon.ico')
        if os.path.exists(site_packages_icon):
            log(f"  Found icon in package: {site_packages_icon}")
        else:
            log(f"  Icon not found in package either")

    # === Phase 6: Post-Install Verification ===
    log_section("Phase 6: Post-Install Verification")
    log("Verifying installation integrity...")
    verification_results = run_post_install_verification()
    passes, fails, warnings, failures = verification_results

    log("")
    log("  " + "=" * 40)
    if fails == 0:
        log(f"  Verification: {passes} passed, {len(warnings)} warnings")
    else:
        log(f"  Verification: {passes} passed, {fails} FAILED, {len(warnings)} warnings")
        log("  Some components may not work correctly.")
        log(f"  Check {LOG_FILE} for details.")
    log("  " + "=" * 40)

    # A failed check in Phase 6 means a package WhisperJAV needs is missing or
    # broken, so the install is not usable. Say so and stop, rather than print
    # "Installation completed successfully!" over the top of it. Optional
    # packages are warnings and never reach here.
    if fails > 0:
        failed_list = ", ".join(failures) if failures else f"{fails} checks"
        log("")
        log("  The installation is NOT usable. These checks failed:")
        for item in failures:
            log(f"    - {item}")
        log("")
        log("  Re-running the installer usually fixes this; if it does not,")
        log("  attach the install log to a report at")
        log("  https://github.com/meizhong986/WhisperJAV/issues")
        create_failure_file(
            f"Core package verification failed after install: {failed_list}"
        )
        # Deliberately not printing the installation summary here: its heading
        # says "Installation Complete!", which this is not.
        return 1

    # === Installation Complete ===
    # Note: Desktop shortcut is now created by NSIS installer during installation
    # The shortcut launches: pythonw.exe -m whisperjav.webview_gui.main
    # Working directory is set to the installation folder ($INSTDIR)
    # Icon: whisperjav_icon.ico in installation folder
    print_installation_summary(install_start_time, verification_results)

    log("\nInstallation completed successfully!")
    log("You may now close this window.")
    return 0


if __name__ == "__main__":
    try:
        exit_code = main()

        if _stopped_on_purpose:
            log(f"Stopped. Log: {LOG_FILE}")
        elif exit_code != 0:
            log("\n" + "!" * 80)
            log("  INSTALLATION FAILED")
            log("!" * 80)
            log(f"Check {LOG_FILE} for details.")
            log("This window will close in 60 seconds...")
            time.sleep(60)
        else:
            log("\nInstallation complete! Window will close in 15 seconds...")
            log("(Press Enter to close immediately)")
            timed_input("", 15, "")

        sys.exit(exit_code)

    except KeyboardInterrupt:
        log("\nInstallation interrupted by user.")
        sys.exit(1)

    except Exception as e:
        log(f"\nFATAL: Unhandled exception occurred:")
        log(str(e))
        log("\nFull traceback:")
        log(traceback.format_exc())
        log("\nThis window will close in 60 seconds...")
        time.sleep(60)
        sys.exit(1)
