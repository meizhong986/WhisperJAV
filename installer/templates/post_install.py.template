STOPPED_MARKER = os.path.join(sys.prefix, "INSTALLATION_STOPPED_v{{VERSION}}.txt")


def create_stopped_file(reason: str) -> None:
    try:
        with open(STOPPED_MARKER, "w", encoding="utf-8") as f:
            f.write("WhisperJAV v{{VERSION}} was not installed: the installer stopped.\n\n")
            f.write(f"Reason: {reason}\n")
            f.write(f"Time: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n")
            f.write(f"Log: {LOG_FILE}\n")
        log(f"Stop recorded in {STOPPED_MARKER}")
    except Exception as e:
        log(f"WARNING: could not write {STOPPED_MARKER}: {e}")


def locked_requirements_path(variant: str) -> str:
    """The locked file for one PyTorch build, shipped next to this script."""
    return os.path.join(sys.prefix, f"requirements_v{{VERSION}}_{variant}.txt")


def requirement_name(line: str) -> str:
    """'torch==2.11.0+cu130' / 'stable-ts @ git+...' / 'x==1 ; marker' -> normalized name."""
    name = re.split(r"[=<>!~;@\[\s]", line.strip(), maxsplit=1)[0]
    return re.sub(r"[-_.]+", "-", name).lower()


def locked_requirement_lines(variant: str) -> List[str]:
    """The requirement lines of the locked file (comments and blank lines dropped)."""
    with open(locked_requirements_path(variant), encoding="utf-8") as f:
        return [line.strip() for line in f if line.strip() and not line.lstrip().startswith("#")]


def torch_pip_args(variant: str) -> List[str]:
    """Install arguments for the three PyTorch packages of one build, from the locked file."""
    lines = [l for l in locked_requirement_lines(variant) if requirement_name(l) in TORCH_PACKAGE_NAMES]
    if not lines:
        raise RuntimeError(f"no PyTorch lines in {locked_requirements_path(variant)}")
    return ["install", "--no-deps", *lines, "--index-url", PYTORCH_INDEXES[variant]]


def variant_of_cuda_build(cuda_build: str) -> Optional[str]:
    """The installed PyTorch's CUDA version ('13.0', '12.8', '' for CPU) -> cu130 / cu128 / cpu."""
    if not cuda_build:
        return "cpu"
    if cuda_build.startswith("13"):
        return "cu130"
    if cuda_build.startswith("12.8"):
        return "cu128"
    return None


def pinned_version(line: str) -> Optional[str]:
    """'packaging==26.3' -> '26.3'; None for a line without ==, such as a git package."""
    m = re.match(r"^[^=<>!~;@\s]+\s*==\s*([^\s;]+)", line.strip())
    return m.group(1) if m else None


def _metadata_name_version(meta_file: Path) -> Tuple[Optional[str], Optional[str]]:
    """Name and Version from a METADATA or PKG-INFO file (its header block)."""
    name = version = None
    try:
        with open(meta_file, encoding="utf-8", errors="replace") as f:
            for line in f:
                if not line.strip():
                    break
                if line.startswith("Name:"):
                    name = line[5:].strip()
                elif line.startswith("Version:"):
                    version = line[8:].strip()
    except OSError:
        pass
    return name, version


def conda_python_packages() -> Tuple[Dict[str, Tuple[str, str]], List[str]]:
    """Python packages conda put into this environment, as pip names them.

    Owner W57 (D1): each conda-meta record lists the *.dist-info (or *.egg-info) folder
    of the Python package it installed; its METADATA gives the PyPI name and version.
    conda's own package name is not used (msgpack-python, brotli-python and python-build
    would never match the locked file). Returns ({normalized name: (name, version)},
    the conda packages that put files into site-packages without such a folder).
    """
    found: Dict[str, Tuple[str, str]] = {}
    unidentified: List[str] = []
    prefix = Path(sys.prefix)
    for record in sorted((prefix / "conda-meta").glob("*.json")):
        try:
            data = json.loads(record.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        conda_name = str(data.get("name", ""))
        if conda_name == "python":
            continue  # the interpreter; its one site-packages file is a README
        site = [str(f).replace("\\", "/") for f in (data.get("files") or [])
                if str(f).replace("\\", "/").lower().startswith("lib/site-packages/")]
        if not site:
            continue
        folders = sorted({"/".join(f.split("/")[:3]) for f in site
                          if f.split("/")[2].lower().endswith((".dist-info", ".egg-info"))})
        if not folders:
            unidentified.append(conda_name)
            continue
        for folder in folders:
            path = prefix / folder
            if path.is_dir():
                path = path / ("METADATA" if folder.lower().endswith(".dist-info") else "PKG-INFO")
            name, version = _metadata_name_version(path)
            if not name or not version:
                # The folder name: <name>-<version>[-pyX.Y].dist-info / .egg-info
                parts = folder.split("/")[-1].rsplit(".", 1)[0].split("-")
                name = name or parts[0]
                version = version or (parts[1] if len(parts) > 1 else "")
            found[re.sub(r"[-_.]+", "-", name).lower()] = (name, version)
    return found, unidentified


def check_conda_packages(locked_lines: List[str], conda_packages: Dict[str, Tuple[str, str]],
                         unidentified: List[str]) -> bool:
    """D1 (owner W57): conda's copy of a pinned package is kept only at the pinned version.

    Every package conda installed that the locked file lists is compared and logged, so
    a check that compared nothing shows as "Checked 0 packages". A different version
    (or a pinned git package) stops the install before anything is installed.
    """
    for conda_name in unidentified:
        log(f"conda's {conda_name} put Python files here without package metadata, so it could not be compared.")
    compared, ok = 0, True
    for line in locked_lines:
        key = requirement_name(line)
        if key not in conda_packages:
            continue
        compared += 1
        name, conda_version = conda_packages[key]
        pinned = pinned_version(line)
        if pinned is not None and pinned == conda_version:
            log(f"Keeping conda's {name} {conda_version}: the same version this release is pinned to.")
            continue
        ok = False
        pinned_text = f"{name} {pinned}" if pinned else line.split(";")[0].strip()
        log(f"Stopped: conda installed {name} {conda_version}, but this release is pinned to {pinned_text}. "
            f"Please report this so it can be fixed: {ISSUES_URL} — attach {os.path.basename(LOG_FILE)}.")
    if ok:
        log(f"Checked {compared} package{'' if compared == 1 else 's'} that conda installed against the "
            f"pinned list: all match.")
    return ok


def release_pinned_install_lines(locked_lines: List[str], conda_packages: Dict[str, Tuple[str, str]]) -> List[str]:
    """The locked lines phase 4 installs: all but PyTorch's three and the ones conda
    installed (already checked to be at the pinned version by check_conda_packages)."""
    return [line for line in locked_lines
            if requirement_name(line) not in TORCH_PACKAGE_NAMES and requirement_name(line) not in conda_packages]


